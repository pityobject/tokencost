# ============================================================
# TokenCost .gitignore
# 原则：面试官要看的（数据、结果、图）必须进仓库；
#       日志与临时产物（体积大、每次跑都变）不进。
# ============================================================

# 服务端日志：16 MB，且每跑一次就变
logs/

# 自测与历史归档：10 MB，含早期假数据实验
_selftest/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 备份文件（断点续跑与手工备份会产生）
*.bak
*_备份_*.jsonl
raw_cells_备份_*.jsonl

# 大模型文件不该进本仓库（模型放 D:\llm\models）
*.gguf

# 注意：以下**故意保留**，它们是项目的证据
#   data/        原始测量数据（raw_cells.jsonl 300 行）
#   results/     fit.json 与预测结果
#   figures/     fig1–fig5

# 自标定产物（每人每机不同，不应提交）
results/calib_*.json

